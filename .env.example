# Copy to .env (Docker) or .env.local (npm run dev). Every value is optional.

# Your SocQ API key (https://socq.ai/dashboard/api-key). If unset, paste it on the Settings page instead.
SOCQ_API_KEY=

# Override the SocQ API base URL (rarely needed).
SOCQ_API_BASE=https://api.socq.ai

# SQLite file by default. Any libsql URL works, e.g. libsql://your-db.turso.io with DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/osl.db
DATABASE_AUTH_TOKEN=

# Require HTTP basic auth (any user name, this password) for every page and API route.
OSL_PASSWORD=

# Email alerts: an SMTP connection URL and the From address.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# ALERT_FROM=Open Social Listening <alerts@example.com>
SMTP_URL=
ALERT_FROM=

# Set to 1 to stop the built-in scheduler (manual "Run now" still works).
OSL_DISABLE_SCHEDULER=
